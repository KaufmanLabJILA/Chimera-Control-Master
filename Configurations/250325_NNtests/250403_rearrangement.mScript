pulseon: gmload .0001
t += 0.1

call setSBcoolPows(0.18, 0.184, 0.18)

call ttlReset() 
t += 1
call dac_reset()
t += 1
on: latticehold
t += 0.01

%pulseon: trigger .01
%pulseon: tektronixtrig .01

%%% MOT %%%
call set_dds_snapshot(4)
call blue_mot(bluemottime)
%call mako_image() % image blue mot


call red_mot(swapmottime)
%call mako_image()
%%% MOT %%%

%%% TWEEZER LOADING %%%
dac: bigzcoil 0
call fieldzero()
call set_dds_snapshot(0)
call magicfields515()
off: blueshut %Extra shutter for safety.
on: shut679
on: shut707
%on: imagshut
t += 12.5 %dropping red MOT
call setSBcoolPows(0.14, 0.003, 0.226)
call lacs(10)  % This wants imaging snapshot

pulseon: gmload .0001
t += .1

call set_dds_snapshot(5)
call setsbcoolpows(0.02, 0.004, 0.03)
%call sbcool(1)
call sbcool_pulsed(time_sbcool_pulsed, pulsenum)
%%% TWEEZER LOADING %%%



call magicfieldsdual813()
dac: bigzcoil 0
on: bigzantihelm
t += 1


%%% HANDOFF TO LATTICE AND IMAGE %%%
call tweezer2lattice(2)

call set_dds_snapshot(0)
call setSBcoolPows(radpow_sbcool, rad2pow_sbcool, axpow_sbcool)
%call sbcool(1)
call sbcool_pulsed(time_sbcool_pulsed, pulsenum)

%%%image lattice
%call set_dds_snapshot(1)
%call setSBcoolPows(radpow_img, rad2pow_img, axpow_img)
%call image(300, imagpowlat, 1)
%%% image lattice fast
call set_dds_snapshot(9)
call setSBcoolPows(radpow_img_fast, rad2pow_img_fast, axpow_img_fast)
call image(imag_lat_time_fast, imagpowlat_fast, 1)
t += 0.01

%%%lattice SB cool
call set_dds_snapshot(0)
call setsbcoolpows(radpow_sbcool, rad2pow_sbcool, axpow_sbcool)
%call sbcool(time_sbcool)
call sbcool_pulsed(time_sbcool_pulsed, pulsenum)

%%%MOVES

off: shut707
off: shut679
off: shut688
off: blueshut
off: imagshut

t += 135 %necessary for rearrangement

call set_dds_snapshot(0)

%call setsbcoolpows(0.033, 0.027, 0.105)

%daclinspace: tweezerpow tweezer_pow -0.9 10 25
%t += 20

%on: tweezerstrobe
%t += .1

%call rerng_arbssmartscrunchxy()
%call rerng_filterarbssmartscrunchxy()
%call rerng_filterarbscrunchycompressx()
call rerng_filterarbssmartscrunchxythrow()
%call rerng_nntest()

%daclinspace: tweezerpow -0.9 tweezer_pow 10 25
%t += 10


%%%lattice SB cool
call set_dds_snapshot(0)
call setSBcoolPows(radpow_sbcool, rad2pow_sbcool, axpow_sbcool)
%call sbcool(1)
call sbcool_pulsed(time_sbcool_pulsed, pulsenum)


%%%image lattice
repeat: 1-fast_image_toggle 
 call set_dds_snapshot(1)
 call setSBcoolPows(radpow_img, rad2pow_img, axpow_img)
 call image(imag_lat_time, imagpowlat, 1)
end
%%% image lattice fast
repeat: fast_image_toggle
 call set_dds_snapshot(9)
 call setSBcoolPows(radpow_img_fast, rad2pow_img_fast, axpow_img_fast)
 call image(imag_lat_time_fast, imagpowlat_fast, 1)
end
t += 0.01


%%%lattice SB cool
call set_dds_snapshot(0)
call setsbcoolpows(radpow_sbcool, rad2pow_sbcool, axpow_sbcool)
call sbcool(time_sbcool)
call sbcool_pulsed(time_sbcool_pulsed, pulsenum)

t += 1

%%% second part of rearrangement
on: t515hold
on: tweezershut
t += 5


call set_dds_snapshot(6)
call setsbcoolpows(radpow_shallow_cool, rad2pow_shallow_cool, axpow_sbcool)
%off: coolSH
%on: radial
%on: radial2
t += .08

%%%% Do More Rearrangement
on: tweezerstrobe
t += 0.1

daccosspace: latticepow lattice_pow lattice_pow_rearrange latramptime 300
%daccosspace: axialpow ax_lattice_pow ax_pow_rearrange 15 300
t += latramptime+0.1

pulseon: trigger .01
%%Compress
repeat: 1
 pulseon: gmmove .0001
 t += .08
 %t += 100.1
 pulseon: gmmove .0001
 t += 4
 %t += 2100.1
 pulseon: gmmove .0001
 t += .08
 %t += 5
 %t += 100.1
end

off: tweezerstrobe
t += 0.1

daccosspace: latticepow lattice_pow_rearrange lattice_pow latramptime 300
%daccosspace: axialpow ax_pow_rearrange ax_lattice_pow 15 300
t += latramptime+0.1

%%%% End More Rearrangement

off: radial
off: radial2
off: axial
on: coolSH

off: tweezershut
t += 5

dac: tweezerpow tweezer_pow
pulseon: gmload .0001
t += 1
off: t515hold



%%% lattice SB cool
call set_dds_snapshot(0)
call setSBcoolPows(radpow_sbcool, rad2pow_sbcool, axpow_sbcool)
%call sbcool(1)
call sbcool_pulsed(time_sbcool_pulsed, pulsenum)


%%%image lattice
repeat: 1-fast_image_toggle 
 call set_dds_snapshot(1)
 call setSBcoolPows(radpow_img, rad2pow_img, axpow_img)
 call image(imag_lat_time, imagpowlat, 1)
end
%%% image lattice fast
repeat: fast_image_toggle
 call set_dds_snapshot(9)
 call setSBcoolPows(radpow_img_fast, rad2pow_img_fast, axpow_img_fast)
 call image(imag_lat_time_fast, imagpowlat_fast, 1)
end
off: imagshut
t += 25 %to remove stripe
on: tweezershut
call magicfields515()
dac: bigzcoil 0


%t += 15 %Remove stripe from 2nd image - unclear where this coming from
%%%END
% don't remove these!


off: andorshut

dac: x1coil 0
dac: y1coil 0
dac: y2coil 0
dac: z1coil 0
dac: bigzcoil 0

on: radial
on: radial2
off: slower %DO NOT REMOVE; avoid coating cell.
%on: imag461
on: axial
on: rp679
on: rp707
on: shut679
on: shut707
%on: red3dnarrow
off: blowawayttl
on: lat813ao
dac: latticepow lattice_pow
dac: axialpow ax_lattice_pow
%off: imag461

on: red3d
dac: red3dpow 1.5

%call bluemot_steadystate() %DO NOT LEAVE ON; avoid coating cell.
%call grafanaSnapshot() %DO NOT LEAVE ON; avoid coating cell.

t += 1

pulseon: resetdds .1
