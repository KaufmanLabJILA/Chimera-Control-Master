% pulseon: stepdds 0.007
% t += .1
%end
%t += .1

%on: imagshut
%t += 4

%on: radial
%t += 0.1
%off: radial
%on: blowawayttl
%t += .004
%off: tweezerao
%t += .001
%on: tweezerao
%t += .001
%off: blowawayttl
%off: imagshut

%%%2nd image, no repumps if doing clock spec
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

%call imageshort()
call imagec()
%call image532()
off: imagshut
%on: slower

%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 5 25
%dac: latticepow -.5
%t += 15 %Remove stripe from 2nd image - unclear where this coming from

%end
%%%REPEAT END%%%

%pulseon: mmmove 0.01
%t += .1

%%%END
% don't remove these!

