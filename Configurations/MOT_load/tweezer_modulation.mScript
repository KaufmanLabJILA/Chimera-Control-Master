t = 1
on: trigger 
t += .1
off: trigger
off: tweezermod
off: redprobe

on: blueshut
on: slower
on: tweezerAO
dac: tweezerpow tweezerpow_val

call blue_mot(50)
off: slower
off: blueshut
dac: blue3dpow 0.01
call red_mot(40)
dac: lowermotcoil 0
dac: uppermotcoil 0
dac: y1coil -2

t += 6
%on: red3d
t += 3
off: red3d
t += 15

%on: redprobe
t += 2
off: redprobe

%blow out pulse

%on: blowawayttl
t += .01
off: blowawayttl

on: tweezermod
t += 5
off: tweezermod

daclinspace: tweezerpow tweezerpow_val -.01 5 10
t += 10
daclinspace: tweezerpow -.01 tweezerpow_val 5 10
t += 5

%off: tweezerAO
%t += .005
%on: tweezerAO

t += 1
daclinspace: tweezerpow tweezerpow_val -5 1 10
t += 1

dac: blue3dpow 0.3
dac: imagingDelta -.3
dac: imagingPow 0.2

%%%%%%Image 1%%%%%

dac: z1coil 0
dac: x1coil .5

t += 1
off: blueshut
on: andorshut
t += 3

%%%%%
on: andortrig
on: mako1
t += .2 
%off: tweezerAO
off: rp707
off: rp679
%on: blue3d
%on: red3dnarrow

on: imag461
t += 0.5
off: imag461

off: andortrig
off: mako1
off: imag461
off: blue3d
%%%%%

on: tweezerAO
dac: red3dpow .4
t += 20

off: andorshut
on: slower
on: red3d
t += 2
off: blueshut
dac: tweezerpow tweezerpow_val
t += 1
call bluemot_steadystate()
t += 1
