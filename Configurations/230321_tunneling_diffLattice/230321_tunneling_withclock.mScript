t += .2
repeat: 3
 pulseon: stepdds 0.007
 t += .1
end
t += .1

%%%% ramp on tweezers
on: tweezershut
%off: tweezershut
t += 5
daccosspace: tweezerpow paint_zero paint_pow 15 15
t += 15

%%% 2D tweezer prep protocol

daccosspace: axialpow ax_lattice_pow tunnel_pow_ax 60 60
daccosspace: latticepow lattice_pow tunnel_pow_2D 60 120
t += 65

on: t515hold
t += .1

daclinspace: tweezeratten tweezerattn_off tweezerfinal tweezerramptime 150
