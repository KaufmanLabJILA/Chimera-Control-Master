 on: radial
 t += .2
 off: radial
 t += .2
 on: axial
 t += .4
 off: axial
 t += .2
 on: radial2
 t += .2
 off: radial2
 t += .2
 on: axial
 t += .4
 off: axial
 t += .2
end

%%% static paint trigger
pulseon: gmload .0001
t += .1
%t += 10
dac: tweezerpow paint_zero
t += 5

%on: radial
%on: radial2
%on: axial
%t += 60
%off: radial
%off: radial2
%off: axial

%repeat: 10
% on: radial
% t += 1
% off: radial
% on: radial2
% t += 1
% off: radial2
% on: axial
% t += 2
% off: axial
%end

