%t += tunnel_time

%daccosspace: axialpow tunnel_pow_ax scan 100 100
%t += 101
%daclinspace: latticepow tunnel_pow_2D pre_tunnel_pow_2D 100 100
%t += 101

dac: axialpow -0.025
dac: latticepow -0.0133

%daclinspace: tweezeratten tweezerfinal tweezerattn_off tweezerramptime 150
%t += tweezerramptime
%t += 1

t += tunnel_time

dac: latticepow pre_tunnel_pow_2D
dac: axialpow tunnel_pow_ax

%t += 5

