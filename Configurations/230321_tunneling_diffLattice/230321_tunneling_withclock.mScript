%call rerng_arbscrunchy()
%call rerng_filterarbscrunchy()
call rerng_filterarbscrunchycompressx()

%daclinspace: axialpow -3.5 ax_lattice_pow 10 10
%t += 10

%%%lattice SB cool

pulseon: resetdds .1
t += .2

%repeat: 50
% on: radial2
% t += .1
% off: radial2
% on: axial
% t += .1
% off: axial
%end

on: radial
on: radial2
on: axial
t += 5
off: radial
off: radial2
off: axial

%pulseon: trigger .1

%%%Image lattice
dac: imagingPow imagpowlat  % imagpowscan

pulseon: stepdds 0.007
t += .1

call imagelat(375)

off: shut707
off: shut679
off: shut688
off: blueshut
off: clkshut
off: imagshut

%dac: z1coil dmbz_center
%t += 15

%%%lattice SB cool

%daclinspace: latticepow lattice_pow -5 10 50
%t += 15

%% switch to helmholtz before cooling
%dac: bigzcoil 0
%t += 4
%off: bigzantihelm
%t += 10
%dac: bigzcoil 0

%%% Set tweezer to filter condition
off: tweezershut
off: t515hold
t += 5

dac: tweezerpow 0.01 %set to low value but which definitely servos
t += 5
%call paintpotential()

%pulseon: gmload .0001
%t += .1

%repeat: 31 % 11 % 7 % 31
% pulseon: gmmove .00011
% t += .08
