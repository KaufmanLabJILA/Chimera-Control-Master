%%%%%
%on: rp688
%on: shut688
call red_mot(swapmottime)
off: rp688
off: shut688
%pulseon: trigger .1

%%%%%
%call mako_image()
on: metertrig
off: mirroractive

dac: bigzcoil 0

%call magicfields515()
call fieldzero()

off: imagshut
on: shut707
on: shut679

off: blueshut %Extra shutter for safety.
t += 4

%%%Light assisted collisions%%%
%call enhanced_lacs(75) % this wants MOT snapshot
%% regular lacs after enhanced loading 
pulseon: stepdds 0.007
t += .1
call magicfields515()
on: imagshut
t += 12.5 %dropping red MOT
call lacs(25)  % This wants imaging snapshot

%off: imagshut

pulseon: gmload .0001
t += .1

%%%SB COOL
%DDS state: SB cooling
pulseon: stepdds 0.007
t += .1

%repeat: 50
% on: axial
% t += .1
% off: axial
% on: radial2
% t += .1
% off: radial2
% on: radial
% t += .1
% off: radial
%end

on: axial
on: radial
t += 5
off: axial
off: radial

on: lat813ao
t += 1

call magicfieldsdual813()

%%% normal handoff
daclinspace: axialpow ax_lattice_zero ax_lattice_pow 10 15
t += 11
daclinspace: latticepow lattice_zero lattice_pow 10 15
t += 11
daclinspace: tweezerpow tweezer_pow tweezer_zero 10 15
t += 15

%%%
off: tweezershut
t += 10
on: tweezerao
dac: tweezerpow tweezer_pow
t += .01

%%%SB COOL LATTICE
pulseon: resetdds .1
t += .2

%repeat: 50
% on: radial2
% t += .1
% off: radial2
% on: axial
% t += .1
% off: axial
%end

on: radial
on: radial2
on: axial
t += 5
off: radial
off: radial2
off: axial

%%%image lattice
dac: imagingPow imagpowlat  % imagpowscan

pulseon: stepdds 0.007
t += .1

call imagelat(150)
off: imagshut %%%IMPORTANT
t += 5

%%%MOVES

pulseon: resetdds .1
t += .2

off: shut707
off: shut679
off: shut688
off: blueshut
off: clkshut
off: imagshut

t += 130 %necessary for rearrangement

%repeat: 50
% on: radial2
% t += .1
% off: radial2
% on: axial
% t += .1
% off: axial
%end

on: radial
on: radial2
on: axial
t += 5
off: radial
off: radial2
off: axial

%rearrangement cooling happens under imaging conditions now.
