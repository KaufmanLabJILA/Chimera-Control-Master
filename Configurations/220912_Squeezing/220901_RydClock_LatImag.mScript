t = 1
 pulseon: resetdds .1
 pulseon: gmload .0001
 
 t += .1
 off: mirroractive 
 dac: mirror_x mirrorscanx
 dac: mirror_y mirrorscany
 
 %DDS state: MOT
 repeat: 4
  pulseon: stepdds 0.007
  t += .1
 end
 
 dac: axial_piezo axial_phase_set
 dac: axial_piezo2 10-axial_phase_set
 
 call ttlReset() 
 t += 1
 
 dac: bluetune bluetuneval
 dac: imagtune tune461
 dac: int633servo 1.
 %dac: uvpm_h 1.5
 dac: uvpm_v 2.5
 
 %dac: tweezerpow 0
 %dac: axialpow ax_lattice_pow
 dac: axialpow ax_lattice_zero
 dac: tweezerpow tweezer_pow
 dac: red3dpow 1.5 %about maximum
 %dac: latticepow lattice_pow
 dac: latticepow lattice_zero
 dac: tweezerpow813 tweezer813_zero
 %dac: tweezerpow813 tweezer813_pow
 
 t += 1
 
 %dac: axialpow -2
 %off: tweezerao
 %off: tweezer813ao
 %off: axlatTTL
 
 %%REMOVE
 t += 1
 
 %on: imagshut
 
 on: blueshut
 on: shut707
 on: shut679
 on: rp707
 on: rp679
 
 %on: shut688
 %on: rp688
 
 %%%%
 %on: imagshut %%Used for mako_image_singleBeam
 %%%%
 %on: blowawayttl
 call blue_mot(bluemottime)
 off: blowawayttl
 off: rp707
 off: rp679
 off: rp688
 off: shut707
 off: shut679
 off: shut688
 
 off: metertrig
 off: radial
 
 off: slower
 
 %call mako_image()
 
 off: blueshut %comment out for mako imaging, uncomment to have andor imaging after redmot.
 
 dac: bluetune 0.4 %0.1  %.6 for blue3d imaging.
 
 %%%%%
 %on: rp688
 %on: shut688
 call red_mot(swapmottime)
 off: rp688
 off: shut688
 pulseon: trigger .1
 
 %%%%%
 %call mako_image()
 on: metertrig
 off: mirroractive
 
 dac: bigzcoil 0
 
 %call magicfields515()
 %call fieldzero()
 
 off: imagshut
 on: shut707
 on: shut679
 
 off: blueshut %Extra shutter for safety.
 t += 4
 
 %%%Light assisted collisions%%%
 %call enhanced_lacs(75) % this wants MOT snapshot
 %% regular lacs after enhanced loading 
 pulseon: stepdds 0.007
 t += .1
 call magicfields515()
 on: imagshut
 t += 12.5 %dropping red MOT
 call lacs(25)  % This wants imaging snapshot
 
 %off: imagshut
 
 pulseon: gmload .0001
 t += .1
 
 %%%SB COOL
 %DDS state: SB cooling
 pulseon: stepdds 0.007
 t += .1
 
 %repeat: 50
 % on: axial
 % t += .1
 % off: axial
 % on: radial2
 % t += .1
 % off: radial2
 % on: radial
 % t += .1
 % off: radial
 %end
 
 on: axial
 on: radial
 t += 5
 off: axial
 off: radial
 
 on: lat813ao
 t += 1
 
 call magicfieldsdual813()
 
 %%% normal handoff
 daclinspace: axialpow ax_lattice_zero ax_lattice_pow 10 15
 t += 11
 daclinspace: latticepow lattice_zero lattice_pow 10 15
 t += 11
 daclinspace: tweezerpow tweezer_pow tweezer_zero 10 15
 t += 15
 
 %%%
 off: tweezershut
 t += 10
 on: tweezerao
 dac: tweezerpow tweezer_pow
 t += .01
 
 %%%SB COOL LATTICE
 pulseon: resetdds .1
 t += .2
 
 %repeat: 50
 % on: radial2
 % t += .1
 % off: radial2
 % on: axial
 % t += .1
 % off: axial
 %end
 
 on: radial
 on: radial2
 on: axial
 t += 6
 off: radial
 off: radial2
 off: axial
 
 %%%image lattice
 dac: imagingPow imagpowlat  % imagpowscan
 
 pulseon: stepdds 0.007
 t += .1
 
 call imagelat(150)
 off: imagshut %%%IMPORTANT
 t += 5


 %%%lattice SB cool
 
 pulseon: resetdds .1
 t += .2
 
 %repeat: 30
 % on: radial
 % t += scan
 % off: radial
 % t += scan
 % on: axial
 % t += scan
 % off: axial
 % t += scan
 % on: radial2
 % t += scan
 % off: radial2
 % t += scan
 % on: axial
 % t += scan
 % off: axial
 % t += scan
 %end
 
 on: radial
 on: radial2
 on: axial
 t += 5
 off: radial
 off: radial2
 off: axial
 
 %%DDS state: spectroscopy
 pulseon: resetdds .1
 t += .2
 repeat: 3
  pulseon: stepdds 0.007
  t += .1
 end
 t += .1

 %%% VV NOTE: for 2D lattice ONLY probe with radial2.
 
 %daclinspace: axialpow ax_lattice_pow scanax 10 15
 %t += 11
 %daclinspace: latticepow lattice_pow scan2d 10 15
 %t += 11
 %call spect3p1()
 %daclinspace: latticepow scan2d lattice_pow 10 15
 %t += 11
 %daclinspace: axialpow scanax ax_lattice_pow 10 15
 %t += 11
 
 %call shelve3p2(0.5)
 
 
 %%% Clock spectroscopy
 
 off: clockttl
 on: clkshut
 off: shut679
 off: shut707
 off: shut688
 t += 5
 off: rp707
 off: rp679
 off: rp688
 
 call fieldbigz()
 %call fieldzero()
 %dac: z1coil 0.4
 
 off: imagshut
 
 %%DDS state: spectroscopy2
 pulseon: resetdds .1
 t += .2
 repeat: 7
  pulseon: stepdds 0.007
  t += .1
 end
 t += .1
 
 %t += 4
 t += 135
 daclinspace: axialpow ax_lattice_pow -0.1 10 50
 t += 15
