%call setSBcoolPows(0.002, 0.002, 0.002)
%off: coolSH
%on: axial
%on: radial
%on: radial2
%t += 1
%off: axial
%off: radial
%off: radial2
%on: coolSH


%%% 3p1 Spectroscopy
%pulseon: resetdds .1
%t += .2
%repeat: 3
% pulseon: stepdds 0.007
% t += .1
%end
%t += .1
%call rabi3p1(rabitime_3p1)
%call setSBcoolPows(0.005, 0.013, 0.012)
%call spect3p1()

%pulseon: trigger .1
%pulseon: tektronixtrig .1
%t += .1

%dac: imagingPow imagpowlat
%t += 1

%%%lattice SB cool
%pulseon: resetdds .1
%t += .2
%call setsbcoolpows(radpow_sbcool, rad2pow_sbcool, axpow_sbcool)
%call sbcool(time_sbcool)

%repeat: 7
% pulseon: stepdds 0.007
% t += .1
%end

%call magicfieldsdual813()
%call imagelatdummy(300) % also need 25ms delay afterward
%t += 35

%daclinspace: latticepow scan2d lattice_pow 10 150
%t += 11
%daclinspace: axialpow scanax ax_lattice_pow 10 15
%t += 11

%%%Image lattice
dac: imagpow1 impow1 %imagpowlat_fast %imagpowlat  % imagpowscan
dac: imagpow2 impow2
%call setSBcoolPows(radpow_img, rad2pow_img, axpow_img)

pulseon: resetdds .1
t += .2
repeat: 1  %1 for normal image, 9 for fast image
 pulseon: stepdds 0.007
 t += .1
end

%call image(300)

%on: latticehold
%on: latblink
on: imagshut
%on: blowawayttl
%on: imag461
t += 25 %to remove stripe
%off: blowawayttl
%off: imag461
%off: latblink

on: tweezershut
call magicfields515()
dac: bigzcoil 0


%t += 15 %Remove stripe from 2nd image - unclear where this coming from
%%%END
% don't remove these!

%dac: tweezerpow tweezer_pow
%dac: axialpow ax_lattice_zero
