off: andorshut

dac: x1coil 0
dac: y1coil 0
dac: y2coil 0
dac: z1coil 0
dac: bigzcoil 0

on: radial
on: radial2
off: slower %DO NOT REMOVE; avoid coating cell.
%on: imag461
on: axial
on: rp679
on: rp707
on: shut679
on: shut707
%on: red3dnarrow
off: blowawayttl
