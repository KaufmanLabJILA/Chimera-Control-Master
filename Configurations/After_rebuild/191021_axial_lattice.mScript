t = 1
pulseon: trigger .1
pulseon: resetdds .1
pulseon: mmload .007
pulseon: gmload .0001
t += .1
off: mirroractive
%on: mirroractive
dac: mirror_y .62
dac: mirror_x 1.7

%DDS state: MOT
repeat: 3
 pulseon: stepdds 0.007
 t += .1
end

dac: galvo galvo_set
dac: axial_piezo axial_phase_set

call ttlReset()
t += 1
on: blowawayshutter
on: blueshut
on: tweezerAO
on: shut689
on: slower
off: imagshut

dac: bluetune bluetuneval
%dac: intensity698 pow698

%dac: tweezerpow 0
dac: axialpow ax_lattice_zero
dac: latticepow lattice_zero
dac: tweezerpow tweezer_pow
%dac: latticepow lattice_pow

t += 1

%dac: axialpow -1
%off: tweezerao

%%REMOVE
dac: imagtune tune461
t += 1
%on: radial

off: repump448

call blue_mot(100)
%call mako_image()

off: slower
%off: imagshut
%on: imag461
on: blueshut

call red_mot(100)
%call mako_image()

dac: axialpow ax_lattice_zero

off: radial
off: mirroractive

dac: motcoils 0

off: blowawayshutter
off: blueshut

call magicfields515()
%call fieldzero()

on: imagshut

t += 10 %dropping red MOT

%%%Light assisted collisions%%%
%DDS state: LAC
pulseon: stepdds 0.007
t += .1

%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

pulseon: mmload 0.007
t += .1
dac: bluetune bluetune_imag
dac: imagingpow 0.05
%on: red3d
%t += 25
%off: red3d

%on: rp707

on: radial
on: axial
on: radial2
on: imag461
t += lactime
off: imag461
off: radial
off: radial2
off: axial
off: rp707
dac: imagingpow imagpow
%%%REPEAT START%%%
repeat: 1

dac: intensity698 0

%on: radial
pulseon: mmload 0.007
t += .1

%%%1st image
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

%call imageshort()
call imagef()
%dac: axialpow ax_lattice_zero

%DDS state: SB cooling
pulseon: resetdds .1
t += .2

%daclinspace: tweezerpow tweezer_pow filter_pow 5 15
%t += 10
  
%dac: imagingPow .175
%on: imagshut
%t += 4
%repeat: 20
%    on: imag461
%    t += 0.2
%    off: imag461
%    on: radial
%    t += 1
%    off: radial
%    on: axial
%    t += 1
%    off: axial
%end
%dac: imagingPow imagpow
%off: imagshut

%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 15 15
t += 20
%daclinspace: tweezerpow tweezer_pow .25 15 15
%t += 20

%repeat: 25
% on: radial
% t += .1
% off: radial
% on: radial2
% t += .1
% off: radial2
% on: axial
% t += .1
% off: axial
%end

%dac: z1coil .005
%dac: y1coil .009
%dac: y2coil .009
%dac: x1coil .5

%%%SPECTROSCOPY
%DDS state: spectroscopy
pulseon: stepdds 0.007
t += .1

%%% blowaway spec:
%on: blowawayshutter
t += 4
%t += 200

%on: radial
t += .05
off: radial

%on: blowawayttl
t += .001
off: tweezerao
t += .001
on: tweezerao
t += .001
off: blowawayttl
off: blowawayshutter

off: tweezermod
off: repump448

call magicfields515()

%DDS state: image
pulseon: stepdds 0.007
t += .1

%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 15 15
t += 20

%daclinspace: tweezerpow tweezer_pow filter_pow 5 15
%t += 55

%daclinspace: tweezerpow filter_pow tweezer_pow 5 15
%t += 15

%%%2nd image, no repumps if doing clock spec

call imagef()
off: imagshut
on: slower

%daclinspace: latticepow lattice_zero lattice_pow 5 15
t += 6

end
%%%REPEAT END%%%

%%%END
% don't remove these!

%dac: tweezerpow tweezerpow_val
%dac: axialpow ax_lattice_zero
%dac: latticepow 0

on: tweezerAO
off: andorshut

dac: x1coil 0
dac: y1coil 0
dac: y2coil 0
dac: z1coil 0
dac: motcoils 0

on: red3d
on: radial
on: radial2
off: slower %DO NOT REMOVE; for avoiding coating of cell.
%on: imag461
on: axial
on: rp679
on: rp707
%on: red3dnarrow
%dac: intensity698 pow698
off: blowawayttl


dac: bluetune bluetuneval
t += 1
%%%
%call bluemot_steadystate()


