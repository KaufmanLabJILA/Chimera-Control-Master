t = .1
pulseon: trigger .1
pulseon: resetdds .1
pulseon: mmload .007
t += .1

call ttlReset()
t += .1
on: blueshut
on: tweezerAO
on: shut689
dac: bluetune bluetuneval
dac: intensity698 pow698
dac: tweezerpow tweezerpow_val
%%REMOVE
dac: imagtune tune461

t += 1
%on: radial2
call blue_mot(30)
%call mako_image()
%off: blowawayshutter
call red_mot(70)
%call mako_image()

off: blueshut
%off: radial2

pulseon: mako1 .05

%0 Further cooling step
pulseon: stepdds 0.007
t += .1

dac: motcoils 0

%magic field values.
dac: z1coil -.003
dac: y1coil .67
dac: y2coil .67
dac: x1coil .525


t += .1 %dropping red MOT

%1 DDS state for LAC step
pulseon: stepdds 0.007
t += .1
%on: red3dnarrow
%t += 30
%off: red3dnarrow

pulseon: mmload 0.007
t += .1

on: imagshut
t += 4

%Light assisted collisions step, lac() routine. 
on: rp707
on: rp679
dac: imagingPow .1
on: imag461
on: radial2
t += 30
off: imag461
off: radial2
%off: imagshut

pulseon: mmload 0.007
t += .1

%2 DDS state for First Image
pulseon: stepdds 0.007
t += .1

%off: blueshut
%%%1st image
dac: intensity698 0

on: rp707
on: rp679
dac: imagingPow .1
on: andorshut
t += 4
on: blue3d
on: andortrig
t += .2

on: imag461
on: radial2
t += 40
off: imag461
off: radial2
off: imagshut
off: slower
off: andortrig

off: andorshut
%3 DDS state for fake Image, post image cooling
pulseon: stepdds 0.007
t += .1


%%%%%%%%%%%%%Sideband cooling%%%%%




%%% Begin Changes for Cooling Optimization


off: rp707
off: rp679
off: blowawayshutter

repeat: 10
 on: radial
 t += .5  %.7
 off: radial
 on: axial
 t += 1
 off: axial
 on: radial2
 t += .5
 off: radial2
end
off: shut689

t += .1

% spec field values
dac: y1coil .017
dac: y2coil .017
dac: x1coil .022
dac: z1coil 0.4

daclinspace: tweezerpow tweezerpow_val filter_pow 15 50
t += 15.2


%4 DDS state for spectroscopy
pulseon: stepdds 0.007
t += 0.11

%on: slower
%on: radial2
%t += 0.1
%off: radial2
%on: blowawayttl
%t += .001
%off: tweezerAO
%t += .001
%on: tweezerAO
%t += 0.002
%off: blowawayttl
%off: slower
%off: blowawayshutter
%off: shut689


%%% End Changes for Cooling Optimization
dac: intensity698 pow698
%off: shut689


%4 DDS state for spectroscopy
%pulseon: stepdds 0.007
t += pulse1
dac: intensity698 0
t += probetime
dac: intensity698 pow698
t += pulse1
dac: intensity698 0
%on: shut689




%%% Rampdown for 3P1 spectroscopy
%t += 6

%t += 35
%dac: z1coil .3136
%dac: x1coil .4

%%%MAGIC ANGLE
%dac: z1coil -.003
%dac: y1coil .7
%dac: x1coil .2689
%dac: x1coil bx_scan

%%%PARAMETRIC HEATING
%on: tweezermod
%t += para_cycles/para_freq/1000
%off: tweezermod
%%%

%%% 3P1 spec
%on: radial2
%t += .1
%off: radial2

%on: blowawayttl
%t += .005
%off: blowawayttl
%off: blowawayshutter
%%%%%
%dac: intensity698 0



%pulseon: mmload 0.007
t += .1

%% Room For Clock Spectroscopy sequence %%


%daclinspace: tweezerpow tweezerpow_val filter_pow 15 25
%t += 20

%%%
%5, 2nd image settings, terminates clock pulse
pulseon: stepdds 0.007





t += .1
on: imagshut

%on: rp679


%%Return to imaging conditions
dac: z1coil -.003
dac: y1coil .67
dac: y2coil .67
dac: x1coil .525
daclinspace: tweezerpow filter_pow tweezerpow_val 15 25
t += 15

%%%2nd image, no repumps if doing clock spec
off: rp707
off: rp679
on: shut689
on: slower

dac: imagingPow .1
on: andorshut
t += 4
on: andortrig
t += .2
on: imag461
on: radial2
t += 40
off: imag461
off: radial2
off: imagshut
off: andorshut
off: andortrig

%%%

%6
pulseon: stepdds 0.007
t += .1

%7
pulseon: stepdds 0.007
t += .1

%8
pulseon: stepdds 0.007
t += .1


% don't remove these!
dac: x1coil 0

dac: y1coil 0
dac: y2coil 0

dac: z1coil 0
dac: motcoils 0
on: red3d
on: radial
off: blue3d
on: blueshut
off: imag461
off: radial2
off: axial
on: rp679
on: rp707
%on: red3dnarrow
dac: intensity698 pow698
on: blowawayshutter

%%%
%call bluemot_steadystate()

%t += 150
