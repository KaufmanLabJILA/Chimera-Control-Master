%  end
  %off: andortrig
  %off: andorshut   
%  off: imag461
%  off: imagshut


%daclinspace: tweezerpow tweezer_pow filter_pow 15 50
%t += 30

%on: radial
%t += scan
%off: radial

%DDS state: SBCool
pulseon: resetdds .1
t += 1


daclinspace: tweezerpow tweezer_pow filter_pow 15 50
t += 15

on: radial
t += heattime
off: radial
t += zholdscan
daclinspace: tweezerpow filter_pow tweezer_pow 15 50
t += 15

t += .1
%dac: x1coil -.2845

%%%SPECTROSCOPY
%DDS state: spectroscopy
pulseon: stepdds 0.007
t += .1
%on: repump448
%on: blowawayshutter
t += 5

repeat: 25
 on: axial
 t += .5
 off: axial
 on: radial
 t += .5
 off: radial
end

on: blowawayttl
t += .001
%off: tweezerao
t += .001
on: tweezerao
t += .001
off: blowawayttl
off: blowawayshutter

off: tweezermod
off: repump448

call magicfields515()
%daclinspace: tweezerpow filter_pow tweezer_pow 15 50
%t += 15
%
%daclinspace: tweezerpow scan tweezer_pow 15 50


%t += 15
%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 15 50
t += 26

%%%2nd image, no repumps if doing clock spec
%DDS state: image
pulseon: stepdds 0.007
t += .1

%DDS state: 813 image
%repeat: 3
% pulseon: stepdds 0.007
% t += .1
%end

%on: rp707
call imagef()
%off: rp707
%call image813()
off: imagshut
on: slower

%daclinspace: latticepow lattice_zero lattice_pow 5 15
t += 6

end
