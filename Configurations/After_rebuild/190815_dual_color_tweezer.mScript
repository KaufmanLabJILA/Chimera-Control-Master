t = 1
pulseon: trigger .1
pulseon: resetdds .1
pulseon: mmload .007
pulseon: gmload .0001
t += .1
off: mirroractive
%on: mirroractive
dac: mirror_y 2.5
dac: mirror_x 1.6

%DDS state: MOT
repeat: 3
 pulseon: stepdds 0.007
 t += .1
end

dac: galvo galvo_set
dac: axial_piezo axial_phase_set

call ttlReset()
t += 1
on: blowawayshutter
on: blueshut
on: tweezerAO
on: shut689
on: slower
off: imagshut
dac: bluetune bluetuneval
%dac: intensity698 pow698

%dac: tweezerpow 0
dac: axialpow 0
dac: latticepow lattice_zero
t += 1
dac: tweezerpow tweezerpow_val
%dac: latticepow lattice_pow

%%REMOVE
dac: imagtune tune461
t += 1
%on: radial

off: repump448

on: rp707
call blue_mot(25)
off: rp707
%call mako_image()
off: slower
off: imagshut
%on: imag461
%on: blueshut

call red_mot(60)
%call mako_image()

off: radial
off: mirroractive

dac: motcoils 0

off: blowawayshutter
off: blueshut

call magicfields515()
%call fieldzero()

on: imagshut

t += 15 %dropping red MOT

%%%Light assisted collisions%%%
%DDS state: LAC
pulseon: stepdds 0.007
t += .1

%DDS state: 813 image
%pulseon: stepdds 0.007
%t += .1

%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

pulseon: mmload 0.007
t += .1
dac: bluetune bluetune_imag
dac: imagingpow imagpow
%on: red3d
%t += 25
%off: red3d

%on: rp707

on: radial
on: axial
on: radial2
on: imag461
t += lactime
off: imag461
off: radial
off: radial2
off: axial
off: rp707

%%%REPEAT START%%%
repeat: 1

dac: intensity698 0

%on: radial
pulseon: mmload 0.007
t += .1

%%%1st image
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

%DDS state: 813 image
%repeat: 3
% pulseon: stepdds 0.007
% t += .1
%end

%on: rp707
%on: rp679
%on: slower
%call imageshort()
call imagef()
%off: rp707
%call image813()
off: imagshut
off: slower

%DDS state: SB cooling
pulseon: resetdds .1
t += .2

on: axial
t += 2
off: axial
on: radial
t += 2
off: radial
on: axial
t += 2
off: axial
on: radial2
t += 2
off: radial2

%%%SPECTROSCOPY
%DDS state: spectroscopy
pulseon: stepdds 0.007
t += .1

%%% blowaway spec:
on: blowawayshutter
t += 4
on: radial2
t += .1
off: radial2

on: blowawayttl
t += .002
off: tweezerao
t += .001
on: tweezerao
t += .001
off: blowawayttl
off: blowawayshutter

%%Return to imaging conditions
%DDS state: image
pulseon: stepdds 0.007
t += .1

%DDS state: 813 image
%repeat: 3
% pulseon: stepdds 0.007
% t += .1
%end

%%%2nd image, no repumps if doing clock spec
%call imageshort()
%on: rp707
call imagef()
%off: rp707
%call image813()
off: imagshut
on: slower

daclinspace: latticepow 0 lattice_pow 5 15
t += 6

end
%%%REPEAT END%%%

%%%END
% don't remove these!

%dac: tweezerpow tweezerpow_val
dac: axialpow 0
%dac: latticepow 0

on: tweezerAO
off: andorshut

dac: x1coil 0
dac: y1coil 0
dac: y2coil 0
dac: z1coil 0
dac: motcoils 0

off: red3d
off: radial
on: radial2
off: slower %DO NOT REMOVE; for avoiding coating of cell.
on: imag461
on: axial
on: rp679
on: rp707
%on: red3dnarrow
%dac: intensity698 pow698
off: blowawayttl


dac: bluetune bluetuneval
t += 1
%%%
%call bluemot_steadystate()


