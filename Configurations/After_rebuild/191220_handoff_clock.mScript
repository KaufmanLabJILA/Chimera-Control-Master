%t += 20

%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 10 50
%t += 15

%%%

%call fieldzero()

%daclinspace: tweezerpow tweezer_pow filter_pow 15 50
%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 15 15
%t += 20

%on: blowawayshutter
%t += 4

%on: radial
%t += .1
%off: radial

%on: blowawayttl
%t += .001
%off: tweezerao
