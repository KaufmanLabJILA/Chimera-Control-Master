t = 1
pulseon: trigger .1
pulseon: resetdds .1
pulseon: mmload .007
pulseon: gmload .0001
t += .1
off: mirroractive
%on: mirroractive
dac: mirror_x 2.15
dac: mirror_y 1.27

%DDS state: MOT
repeat: 3
 pulseon: stepdds 0.007
 t += .1
end

dac: galvo galvo_set
dac: axial_piezo axial_phase_set

call ttlReset()
t += 1
on: blowawayshutter
on: blueshut
on: tweezershut
on: tweezerAO
on: tweezer813ao
on: axlatTTL
on: axlatshut
on: shut689
on: slower
on: shut707 
on: shut679 
off: imagshut
off: shut688
off: uvaottl
dac: intensity698 -4.5 %-0.05 %-.015 %-8.5 is Max %-0.01

dac: bluetune bluetuneval
%dac: intensity698 pow698

dac: axialpow ax_lattice_zero
%dac: latticepow lattice_zero
dac: tweezerpow tweezer_pow
%dac: latticepow lattice_pow

t += 1

%dac: axialpow -2
%off: tweezerao
%off: tweezer813ao
%off: axlatTTL

%%REMOVE
dac: imagtune tune461
t += 1


call blue_mot(50)
%call mako_image()

off: slower
%off: imagshut
%on: imag461
%on: blueshut

call red_mot(60)
%call mako_image()

%%% turn off repumps after mots:
off: rp707
off: rp679
off: shut707
off: shut679
%%%

off: mirroractive

dac: motcoils 0

off: blowawayshutter
off: blueshut

call magicfields515()

dac: latticepow lattice_zero
on: imagshut

t += 10 %dropping red MOT

%%%Light assisted collisions%%%
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

pulseon: mmload 0.007
t += .1

dac: bluetune bluetune_imag
dac: imagingPow imagpow
%on: rp707

t += .1

on: imag461
%on: radial2
on: radial
on: axial
t += 50
off: radial2
off: axial
off: radial
off: imag461
%off: imagshut

pulseon: mmload 0.007
t += .1

%%%REPEAT START%%%
%repeat: 1

%on: radial

%DDS state: Image 
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

%%%1st image

%call imageshort()
call imagec()

%%%SB COOL

%DDS state: SB cooling
pulseon: resetdds .1
t += .2

repeat: 25
 on: axial
 t += .1
 off: axial
% on: radial2
% t += .1
% off: radial2
 on: radial
 t += .1
 off: radial
end

%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 5 25
%t += 10

%repeat: 7
% pulseon: stepdds 0.007 
% t += .2 
%end 
%t += .1 

%repeat: 25
% on: axial
% t += .1
% off: axial
% on: radial2
% t += .1
% off: radial2
% on: radial
% t += .1
% off: radial
%end

%%%HANDOFF

%dac: x1coil -.0948/16
%dac: y1coil 0.233/16
%dac: y2coil 0.233/16
%dac: z1coil -.05


dac: y1coil .009
dac: y2coil .009
dac: x1coil .014
dac: z1coil .4 %%%MAX Bz VALUE
%dac: z1coil .04
%dac: z1coil .2
t += 10

%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 10 25
%t += 15

dac: intensity698 -4.5 %-0.05 %-.015 %-8.5 is Max %-0.01

off: axlatTTL
off: axlatshut

daclinspace: latticepow lattice_zero -.5 5 25
t += 15
daclinspace: tweezerpow tweezer_pow tweezer_zero 5 25
t += 15
daclinspace: latticepow -.5 lattice_pow 5 25
t += 15

%on: tweezerhold
%t += 20
%off: tweezerao
%t += 5
pulseon: gmmove .007
t += 5
%off: tweezershut
t += 15

dac: tweezerpow -.1

%%CLOCK
%on: uvaottl
%DDS State: spectroscopy
pulseon: stepdds 0.007
t += probetime

%dac: intensity698 0

%repeat: 100
% pulseon: gmload .007
% t += 1
%end
%pulseon: gmmove .007
%t += 1

%repeat: 10
% on: c15
% t += 0.1
% off: c15
%t += holdtime_d10
% t += ramseytime_d10 
%end

%t += ramseytime 

%pulseon: trigger .1
%dac: intensity698 -4

%t += probetime

pulseon: stepdds 0.007
t += .1

%on: uvaottl
%t += 2000
off: uvaottl


on: shut707 
on: rp707
t += 6
on: blowawayshutter
t += 4
off: rp707
off: shut707 
on: blowawayttl
t += .01
off: blowawayttl
off: blowawayshutter

dac: tweezerpow tweezer_zero
daclinspace: latticepow lattice_pow -.5 5 25
t += 15

%%%
%t += 50
%on: tweezerao
%t += 5
%dac: tweezerpow tweezer_zero
%t += 5
%off: tweezerhold
%t += 40

on: tweezershut
dac: tweezerpow -.2
t += 10
pulseon: gmload .007
t += 10


%on: tweezerao
%t += 50
%t += 400
%pulseon: gmload .007
%t += 20

daclinspace: tweezerpow tweezer_zero tweezer_pow 5 25
t += 15
daclinspace: latticepow -.5 lattice_zero 5 25
t += 15

on: shut707 
on: shut679 
t += 4
on: rp679
on: rp707
t += 6
off: rp679
off: rp707 
off: shut707 
off: shut679 




%dac: intensity698 -5

%on: axlatTTL
%t += 1
%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 5 25
%t += 10

%%%SPECTROSCOPY
%DDS state: spectroscopy
%pulseon: resetdds .1
%t += .2
%pulseon: stepdds 0.007
%t += .1

