t = 1
pulseon: trigger .1
pulseon: resetdds .1
pulseon: mmload .007
pulseon: gmload .0001
t += .1

%on: mirroractive
dac: mirror_y 2.275
dac: mirror_x 2.4

%DDS state: MOT
repeat: 3
 pulseon: stepdds 0.007
 t += .1
end

dac: galvo galvo_set
dac: axial_piezo axial_phase_set

call ttlReset()
t += 1
on: blowawayshutter
on: blueshut
on: tweezerAO
%off: tweezerAO
on: shut689
on: slower
dac: bluetune bluetuneval
dac: intensity698 pow698
dac: tweezerpow tweezerpow_val
dac: axialpow 0
%dac: axialpow lattice_pow
%%REMOVE
dac: imagtune tune461

t += 1

%on: radial
call blue_mot(60)
off: slower
off: blowawayshutter
%call mako_image()
%on: imagshut
%on: imag461
call red_mot(100)

%call mako_image()
off: imag461
off: imagshut

off: blueshut
off: radial


%pulseon: mako1 .05

off: mirroractive

dac: motcoils 0

%call fieldZero()

on: imagshut
on: blowawayshutter

call magicfields515()
%call fieldZero()

t += 10 %dropping red MOT

%DDS state: LAC
pulseon: stepdds 0.007
t += .1

pulseon: mmload 0.007
t += .1
dac: bluetune bluetune_imag

%%%Light assisted collisions%%%
%on: red3d
%t += 25
%off: red3d

dac: imagingPow .1
on: radial2
%on: radial
on: imag461
on: imagshut
t += lactime
off: blowawayshutter
off: imag461
off: radial
off: radial2

%%%REPEAT START%%%
repeat: 1

dac: intensity698 0

%on: radial
pulseon: mmload 0.007
t += .1

%%%1st image
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

on: rp707
on: rp679
call imagef()
off: imagshut
off: slower
off: radial2

%DDS state: SB cooling
pulseon: resetdds .1
t += .2
t += 50
%%%Sideband cooling%%%
%call fieldMagic()
%off: rp707
%off: rp679
on: blowawayshutter
%daclinspace: tweezerpow tweezerpow_val filter_pow 10 15
%t += 15.1

%on: radial2
%t += scan
%off: radial2

%daclinspace: tweezerpow filter_pow tweezerpow_val 10 15
%t += 15.1
%daclinspace: axialpow 0 lattice_pow 10 15
%t += 15.1

%repeat: 10
%on: radial
%t += 1 %.5  %.7
%off: radial
%on: axial
%t += 1
%off: axial
%on: radial2
%t += 1
%off: radial2
%on: axial
%t += 1
%off: axial
%end
%t += 1
on: imagshut
t += 15.1
%dac: intensity698 0



%DDS state: spectroscopy
pulseon: stepdds 0.007
t += .1

on: radial2
%on: axial
t += .1
off: axial
off: radial2
%on: blowawayttl
%on: slower
%on: imag461
%t += 20
t += .002
%off: tweezerao
t += .001
on: tweezerao
t += 0.001
off: blowawayttl
off: slower

off: imag461
off: imagshut

%%%FAKE IMAGE%%%
on: blowawayshutter
t += 5
dac: imagingPow .15
%on: radial2
on: radial
%on: axial
%on: slower

t += 1

t += .1
off: blowawayshutter
off: imagshut
off: slower
off: radial
off: radial2
off: axial




%pulseon: mmload 0.007
t += .1

%%Return to imaging conditions
%DDS state: image, terminates clock pulse
pulseon: stepdds 0.007
t += .1

on: imagshut
on: blowawayshutter
on: rp707
on: rp679
on: shut689

%%%2nd image, no repumps if doing clock spec

on: rp707
on: rp679
call imagef()
off: imagshut
off: slower
off: radial2


on: rp707
on: rp679
t += 5

daclinspace: axialpow ax_lattice_pow 0 10 15
t += 15.1

end
%%%REPEAT END%%%

%%%END

% don't remove these!
off: andorshut

dac: x1coil 0

dac: y1coil 0
dac: y2coil 0

dac: z1coil 0
dac: motcoils 0
dac: imagingPow 0.15
on: red3d
off: radial
on: radial2
off: slower %DO NOT REMOVE; for avoiding coating of cell.
on: imag461
on: axial
on: rp679
on: rp707
%on: red3dnarrow
dac: intensity698 pow698
on: blowawayshutter
off: blowawayttl

dac: bluetune bluetuneval
%t += 1
%%%
%call bluemot_steadystate()
%t +=
