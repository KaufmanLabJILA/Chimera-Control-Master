t = 1

pulseon: trigger .1
pulseon: resetdds .1
pulseon: mmload .007
pulseon: gmload .0001
t += .1
off: mirroractive
%on: mirroractive
dac: mirror_x 2.2
dac: mirror_y 1.27

dac: motcoils 4

%DDS state: MOT
repeat: 3
 pulseon: stepdds 0.007
 t += .1
end

dac: galvo galvo_set
dac: axial_piezo axial_phase_set

call ttlReset()
t += 1
on: blowawayshutter
on: blueshut
on: tweezerAO
on: tweezer813ao
on: lat813ao
on: axlatTTL
on: axlatshut
on: shut689
on: slower
off: imagshut
off: shut688

dac: bluetune bluetuneval
%dac: intensity698 pow698

%dac: tweezerpow 0
dac: axialpow ax_lattice_zero
dac: latticepow lattice_zero
dac: tweezerpow tweezer_pow
%dac: latticepow lattice_pow

t += 1

%dac: axialpow -2
%off: tweezerao
%off: tweezer813ao
%off: axlatTTL

%%REMOVE
dac: imagtune tune461
t += 1
%on: radial


call blue_mot(100)
%call mako_image()

off: slower
%off: imagshut
%on: imag461
%off: blueshut %uncomment this to have andor imaging after redmot.

call red_mot(rmtime)
call mako_image()


%dac: bluetune bluetune_imag
%dac: imagingPow imagpow
%on: andorshut
%on: imagshut
%t += .5
%on: andortrig
%t += .1
%on: imag461
%on: rp707
%on: rp679
%t += 75
%off: radial2
%off: axial
%off: radial
%off: rp707
%off: rp679
%off: shut707
%off: shut679
%off: andortrig
%off: andorshut   
%off: imag461
%off: imagshut
%t += .01



off: radial
off: mirroractive

dac: motcoils 0

off: blowawayshutter
off: blueshut

call magicfields515()
%call fieldzero()
%call fields532()

%daclinspace: axialpow -2 ax_lattice_zero 15 15
%t += 20

dac: latticepow lattice_zero
on: imagshut

t += 10 %dropping red MOT

%%%Light assisted collisions%%%
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

pulseon: mmload 0.007
t += .1

dac: bluetune bluetune_imag
dac: imagingPow imagpow
%on: rp707

t += .1

on: imag461
%on: radial2
on: radial
on: axial
t += 50
off: radial2
off: axial
off: radial
off: imag461

%off: imagshut

pulseon: mmload 0.007
t += .1

%%%REPEAT START%%%
%repeat: 1

%on: radial

%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

%%%1st image

%call imageshort()
call imagec()

%%%SB COOL
%DDS state: SB cooling
pulseon: resetdds .1
t += .2

repeat: 25
 on: axial
 t += .1
 off: axial
% on: radial2
 t += .1
 off: radial2
 on: radial
 t += .1
 off: radial
end

%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 5 25
%t += 10

%repeat: 7
% pulseon: stepdds 0.007 
% t += .2 
%end 
%t += .1 

repeat: 25
 on: axial
 t += .1
 off: axial
% on: radial2
 t += .1
 off: radial2
 on: radial
 t += .1
 off: radial
end


%%%HANDOFF

%dac: x1coil -.0948/16
%dac: y1coil 0.233/16
%dac: y2coil 0.233/16
%dac: z1coil -.05

%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 5 25
%t += 10

%off: axlatTTL
%off: axlatshut

%daclinspace: latticepow lattice_zero -0.6 5 25
%t += 15
%daclinspace: tweezerpow tweezer_pow tweezer_zero 5 25
%t += 15
%daclinspace: latticepow -0.6 lattice_pow 5 25
%t += 15

%pulseon: gmmove .007
%t += 5
%off: tweezershut
%t += 4

%dac: tweezerpow -1

%repeat: 10
% on: c15
% t += 0.1
% off: c15
% t += holdtime_d10
%end

%t += holdtime

%dac: tweezerpow tweezer_zero
%daclinspace: latticepow lattice_pow -0.6 5 25
%t += 15

%on: tweezershut
%t += 10
%pulseon: gmload .007
%t += 10

%daclinspace: tweezerpow tweezer_zero tweezer_pow 5 25
%t += 15
%daclinspace: latticepow -0.6 lattice_zero 5 25
%t += 15




%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 5 25
%t += 10
%off: axlatTTL

%call handoff(holdtime)

%on: axlatTTL
%on: axlatshut
%t += 4
%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 5 25
%t += 10

%%% FAKE IMAGE
%dac: bluetune bluetune_imag
%dac: imagingPow scan
%on: imagshut
%t += 4
%on: imag461
%on: radial
%on: axial
%t += 75
%off: axial
%off: radial
%off: imag461
%off: imagshut
%t += .01

%t += holdtime


%%%SPECTROSCOPY
%DDS state: spectroscopy
pulseon: resetdds .1
t += .2
pulseon: stepdds 0.007
t += .1

%%%FAKE IMAGE
%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 10 50
%t += 20

%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 10 50
%t += 15

%%%

%call fieldzero()

%daclinspace: tweezerpow tweezer_pow filter_pow 15 50
%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 15 15
%t += 20

%off: rp679
%off: rp707
%t += .1

%call shelve3p0(1) %need spect DDS radial @ 80.075, 20%  

%call recover3p0(3)

on: blowawayshutter
t += 4
on: radial
t += .1
%t += 3
off: radial

on: blowawayttl
t += .001
off: tweezerao
%off: axlatTTL
t += .003
on: tweezerao
%on: axlatTTL
t += .001
off: blowawayttl
off: blowawayshutter
%off: imagshut

%daclinspace: tweezerpow filter_pow tweezer_pow 15 50
%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 5 25

off: tweezermod

t += 30

%%%2nd image, no repumps if doing clock spec
%DDS state: image
pulseon: stepdds 0.007
t += .1
call imagec()
%call image532()
off: imagshut
%on: slower

%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 5 25
dac: latticepow -.5
t += 15 %Remove stripe from 2nd image - unclear where this coming from


%end
%%%REPEAT END%%%

