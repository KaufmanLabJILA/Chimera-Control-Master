t = 1
pulseon: trigger .1
pulseon: resetdds .1
pulseon: mmload .007
t += .1

call ttlReset()
t += 1
on: blueshut
on: tweezerAO
on: shut689
dac: intensity698 pow698
dac: tweezerpow tweezerpow_val
%%REMOVE
dac: imagtune tune461

t += 1

%on: radial2
call blue_mot(20)
%call mako_image()
off: blowawayshutter
call red_mot(100)
%call mako_image()
off: blueshut
%off: radial2

%0 Further cooling step
pulseon: stepdds 0.007
t += .1

dac: motcoils 0

%Zero field values.
dac: z1coil -.003
dac: y1coil .017
dac: x1coil .022

t += 10 %dropping red MOT

%1 DDS state for LAC step
pulseon: stepdds 0.007
t += .1
%on: red3dnarrow
%t += 30
%off: red3dnarrow

pulseon: mmload 0.007
t += .1

on: imagshut
t += 4

%Light assisted collisions step, lac() routine. 
call lac()

pulseon: mmload 0.007
t += .1

%2 DDS state for First Image
pulseon: stepdds 0.007
t += .1

%off: blueshut
%%%1st image
on: rp707
on: rp679
call imagef()
off: imagshut

off: slower %%%FIX%%%

%post image sisphhis
%on: radial2
%t += 70
%off: radial2

%3 DDS state for fake Image, post image cooling
pulseon: stepdds 0.007
t += .1

%%Fake image%%
%dac: imagingPow 0.3
%t += 1
%repeat: 5

%on: imag461
%on: radial
%on: axial
%t += 18
%off: imag461
%off: radial
%off: axial
%on: rp707
%on: rp679

%Recool
%t += .1
%on: radial
%t += 30
%off: radial 
%t += .1
%end
%%Fake image%%

%%%%%%%%%%%%%Sideband cooling%%%%%

%%%Change field values%%%
dac: z1coil 0.2
dac: x1coil .27

%dac: z1coil .3136
%dac: x1coil .4

t += 20

%post image cooling: 10% power, 83MHz freq

%on: radial2
%t += 25
%off: radial2

%repeat: 5
% on: radial
% t += 3  %.7
% off: radial
% %on: axial
% %t += 1
% %off: axial
% on: radial2
% t += 3
% off: radial2
% %on: axial
% %t += 1
% off: axial
%end

% for old cooling: radial power was 11, radial2 power was 25

%%% Begin Changes for Cooling Optimization
dac: z1coil .3136
dac: x1coil .4

daclinspace: tweezerpow tweezerpow_val -4 30 50

off: rp707
off: rp679
%t += 20

repeat: 15
on: radial
t += 1
off: radial
%on: axial
%t += .2
%off: axial
on: radial2
t += 1
off: radial2
end

daclinspace: tweezerpow -4 tweezerpow_val 30 50
repeat: 15
on: radial
t += 1
off: radial
on: radial2
t += 1
off: radial2
end

t += 5 %15

%%% End Changes for Cooling Optimization

%4 DDS state for spectroscopy
pulseon: stepdds 0.007
dac: intensity698 0

%%% Rampdown for 3P1 spectroscopy
on: blowawayshutter
dac: z1coil .3136
dac: x1coil .4

daclinspace: tweezerpow tweezerpow_val filter_pow 15 25

off: rp707
off: rp679
t += 20

on: axial
t += .01
off: axial

on: blowawayttl
t += .005
off: blowawayttl
off: blowawayshutter

%%%PARAMETRIC HEATING
%on: tweezermod
%t += para_cycles/para_freq/1000
%off: tweezermod
%t += 5
%%%
daclinspace: tweezerpow filter_pow tweezerpow_val 15 25
t += 15

dac: x1coil .022 %return field x to 0 

pulseon: mmload 0.007
t += .1

%% Room For Clock Spectroscopy sequence %%

dac: intensity698 pow698
on: rp707
on: rp679
%off: shut689
%dac: z1coil 0.4
%daclinspace: tweezerpow tweezerpow_val filter_pow 15 25
%t += 20

%%%
%5, 2nd image settings, terminates clock pulse
pulseon: stepdds 0.007
t += .1

on: imagshut

%%Return to imaging conditions
dac: z1coil -.003
dac: y1coil .017
dac: x1coil .022
%daclinspace: tweezerpow filter_pow tweezerpow_val 15 25
t += 15

%%%2nd image, no repumps if doing clock spec
on: rp707
on: rp679
%on: shut689
on: slower

t += 4
call imagef()
off: imagshut

%%%

%6
pulseon: stepdds 0.007
t += .1

%7
pulseon: stepdds 0.007
t += .1

%8
pulseon: stepdds 0.007
t += .1


% don't remove these!
dac: x1coil 0
dac: y1coil 0
dac: z1coil 0
dac: motcoils 0
on: red3d
on: radial
on: imag461
on: radial2
off: axial
on: rp679
on: rp707
%on: red3dnarrow
dac: intensity698 pow698
on: blowawayshutter

t += 1
%%%
%call bluemot_steadystate()

%t += 150
