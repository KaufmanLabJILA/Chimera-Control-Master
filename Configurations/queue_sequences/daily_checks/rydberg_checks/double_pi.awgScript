% start by resetting synthesizer
reset

setsingle 0 0 0 ryd_freq 1 0
setsingle 0 1.08 awgamp ryd_freq 0 0
setsingle 0 (uvtime_pi + 1.08) 0 ryd_freq 0 0
setsingle 0 (uvtime_pi + ramseytime + 1.08) awgamp ryd_freq 0 0
setsingle 0 (2*uvtime_pi + ramseytime + 1.08) 0 ryd_freq 0 0 

program 0 

setsingle 1 0 0 ryd_freq 1 0
setsingle 1 1.08+delayuv12 awgamp2 ryd_freq 0 0
setsingle 1 (uvtime_pi + 1.08 + delayuv12) 0 ryd_freq 0 0
setsingle 1 (uvtime_pi + ramseytime + 1.08 + delayuv12) awgamp2 ryd_freq 0 0
setsingle 1 (2*uvtime_pi + ramseytime + 1.08 + delayuv12) 0 ryd_freq 0 0

program 1 

program 2

setsingle 3 0 0 f_407 1 0
setsingle 3 (1.08 + uvtime_pi + uv407delay) pow_407 f_407 0 0
setsingle 3 (1.08 + uvtime_pi + uv407delay + time407) 0 f_407 0 0

program 3

% Software trigger for testing
%trigger
%trigger%
