pulseon: gmload .0001
t += 0.1

call setSBcoolPows(0.18, 0.184, 0.18)

call ttlReset() 
t += 1
call dac_reset()
t += 1
on: latticehold
t += 0.01

%%% MOT %%%
call set_dds_snapshot(4)
call blue_mot(bluemottime)
call red_mot(swapmottime)
%%% MOT %%%


%%% TWEEZER LOADING %%%
daccosspace: bigzcoil bigz_redmot*bigz_conv bz0 10 50
call set_dds_snapshot(0)
call magicfields515()
off: blueshut %Extra shutter for safety.
on: shut679
on: shut707
%on: imagshut
t += 12.5 %dropping red MOT
call setSBcoolPows(0.14, 0.003, 0.226)
call lacs(20)  % This wants imaging snapshot

pulseon: gmload .0001
t += .1

call set_dds_snapshot(5)
call setsbcoolpows(0.02, 0.004, 0.03)
%call sbcool(1)
call sbcool_pulsed(time_sbcool_pulsed, pulsenum)
%%% TWEEZER LOADING %%%



call magicfieldsdual813()
dac: bigzcoil 0
on: bigzantihelm
t += 1


%%% HANDOFF TO LATTICE AND IMAGE %%%
call tweezer2lattice(2)

call set_dds_snapshot(0)
call setSBcoolPows(radpow_sbcool, rad2pow_sbcool, axpow_sbcool)
%call sbcool(1)
call sbcool_pulsed(time_sbcool_pulsed, pulsenum)

%%%image lattice
repeat: 1-fast_image_toggle 
 call set_dds_snapshot(1)
 call setSBcoolPows(radpow_img, rad2pow_img, axpow_img)
 call image(imag_lat_time, imagpowlat, 1)
end
%%% image lattice fast
repeat: fast_image_toggle
 call set_dds_snapshot(9)
 call setSBcoolPows(radpow_img_fast, rad2pow_img_fast, axpow_img_fast)
 call image(imag_lat_time_fast, imagpowlat_fast, 1)
end

%%%lattice SB cool
%pulseon: trigger .01
pulseon: tektronixtrig .01
t += .01
call set_dds_snapshot(0)
call setsbcoolpows(radpow_sbcool, rad2pow_sbcool, axpow_sbcool)
%call sbcool(time_sbcool)
call sbcool_pulsed(time_sbcool_pulsed, pulsenum)

pulseon: trigger .01
t += 0.01





call set_dds_snapshot(3)
call setSBcoolPows(0.002, 0.002, 0.002)
call sbcool(1)
call spect3p1(0, 0, 1)




%%%image lattice
repeat: 1-fast_image_toggle 
 call set_dds_snapshot(1)
 call setSBcoolPows(radpow_img, rad2pow_img, axpow_img)
 call image(imag_lat_time, imagpowlat, 1)
end
%%% image lattice fast
repeat: fast_image_toggle
 call set_dds_snapshot(9)
 call setSBcoolPows(radpow_img_fast, rad2pow_img_fast, axpow_img_fast)
 call image(imag_lat_time_fast, imagpowlat_fast, 1)
end
%on: imagshut
daccosspace: y1coil 0.7 0 40 80
daccosspace: y2coil 0.7 0 40 80
daccosspace: z1coil dmbz 0 40 80
t += 15+25 %to remove stripe

off: shut688
on: tweezershut
%call magicfields515()
%dac: bigzcoil 0


%t += 15 %Remove stripe from 2nd image - unclear where this coming from

%t += 300


%%%END
off: andorshut

dac: x1coil 0
%dac: y1coil 0
%dac: y2coil 0
%dac: z1coil 0
dac: bigzcoil 0

%on: radial
%on: radial2
off: slower %DO NOT REMOVE; avoid coating cell.
%on: imag461
%on: axial
on: rp679
on: rp707
on: shut679
on: shut707
%on: red3dnarrow
off: blowawayttl
on: lat813ao
dac: latticepow lattice_pow
dac: axialpow ax_lattice_pow
%off: imag461

on: red3d
dac: red3dpow 1.5

%call bluemot_steadystate() %DO NOT LEAVE ON; avoid coating cell.
%call grafanaSnapshot() %DO NOT LEAVE ON; avoid coating cell.

t += 1

pulseon: resetdds .1

 
