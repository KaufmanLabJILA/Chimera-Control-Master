t = 1
pulseon: resetdds .1
pulseon: gmload .0001

t += .1
off: mirroractive 
dac: mirror_x mirrorscanx
dac: mirror_y mirrorscany

%DDS state: MOT
repeat: 4
 pulseon: stepdds 0.007
 t += .1
end

dac: axial_piezo axial_phase_set
dac: axial_piezo2 10-axial_phase_set

call ttlReset() 
t += 1

dac: bluetune bluetuneval
dac: imagtune tune461
dac: int633servo 1.

%dac: tweezerpow 0
%dac: axialpow ax_lattice_pow
dac: axialpow ax_lattice_zero
dac: tweezerpow tweezer_pow
dac: red3dpow 1.5 %about maximum
%dac: latticepow lattice_pow
dac: latticepow lattice_zero
dac: tweezerpow813 tweezer813_zero
%dac: tweezerpow813 tweezer813_pow

t += 1

%dac: axialpow -2
%off: tweezerao
%off: tweezer813ao
%off: axlatTTL

%%REMOVE
t += 1

%on: imagshut

on: blueshut
on: shut707
on: shut679
on: rp707
on: rp679

%on: shut688
%on: rp688

%%%%
%on: imagshut %%Used for mako_image_singleBeam
%%%%
%on: blowawayttl
call blue_mot(bluemottime)
off: blowawayttl
off: rp707
off: rp679
off: rp688
off: shut707
off: shut679
off: shut688

off: metertrig
off: radial

off: slower

%call mako_image()

off: blueshut %comment out for mako imaging, uncomment to have andor imaging after redmot.

dac: bluetune 0.4 %0.1  %.6 for blue3d imaging.

%%%%%
%on: rp688
%on: shut688
call red_mot(swapmottime)
off: rp688
off: shut688
pulseon: trigger .1

%%%%%
%call mako_image()
on: metertrig
off: mirroractive

dac: bigzcoil 0

%call magicfields515()
call fieldzero()

off: imagshut
on: shut707
on: shut679

off: blueshut %Extra shutter for safety.
t += 4

%%%Light assisted collisions%%%
%call enhanced_lacs(75) % this wants MOT snapshot
%% regular lacs after enhanced loading 
pulseon: stepdds 0.007
t += .1
call magicfields515()
on: imagshut
t += 12.5 %dropping red MOT
call lacs(25)  % This wants imaging snapshot

%off: imagshut

pulseon: gmload .0001
t += .1

%%%SB COOL
%DDS state: SB cooling
pulseon: stepdds 0.007
t += .1

%repeat: 50
% on: axial
% t += .1
% off: axial
% on: radial2
% t += .1
% off: radial2
% on: radial
% t += .1
% off: radial
%end

on: axial
on: radial
t += 5
off: axial
off: radial

on: lat813ao
t += 1

call magicfieldsdual813()

%%% normal handoff
daclinspace: axialpow ax_lattice_zero ax_lattice_pow 10 15
t += 11
daclinspace: latticepow lattice_zero lattice_pow 10 15
t += 11
daclinspace: tweezerpow tweezer_pow tweezer_zero 10 15
t += 15

%%%
off: tweezershut
t += 10
on: tweezerao
dac: tweezerpow tweezer_pow
t += .01

%%%SB COOL LATTICE
pulseon: resetdds .1
t += .2

%repeat: 50
% on: radial2
% t += .1
% off: radial2
% on: axial
% t += .1
% off: axial
%end

on: radial
on: radial2
on: axial
t += 5
off: radial
off: radial2
off: axial

%%%image lattice
dac: imagingPow imagpowlat  % imagpowscan

pulseon: stepdds 0.007
t += .1

call imagelat(300)
off: imagshut %%%IMPORTANT
t += 5

%%%MOVES

pulseon: resetdds .1
t += .2

off: shut707
off: shut679
off: shut688
off: blueshut
off: clkshut
off: imagshut

t += 110 %necessary for rearrangement

%repeat: 50
% on: radial2
% t += .1
% off: radial2
% on: axial
% t += .1
% off: axial
%end

on: radial
on: radial2
on: axial
t += 5
off: radial
off: radial2
off: axial

%rearrangement cooling happens under imaging conditions now.
pulseon: stepdds 0.007
t += .1

%daclinspace: axialpow ax_lattice_pow -3.5 10 10
%t += 10

%call rerng_arbscrunchy()
call rerng_filterarbscrunchy()
%call rerng_filterarbscrunchycompressx()

%daclinspace: axialpow -3.5 ax_lattice_pow 10 10
%t += 10

%%%lattice SB cool

pulseon: resetdds .1
t += .2

%repeat: 50
% on: radial2
% t += .1
% off: radial2
% on: axial
% t += .1
% off: axial
%end

on: radial
on: radial2
on: axial
t += 5
off: radial
off: radial2
off: axial

%pulseon: trigger .1

%%%Image lattice
dac: imagingPow imagpowlat  % imagpowscan

pulseon: stepdds 0.007
t += .1

call imagelat(300)

off: shut707
off: shut679
off: shut688
off: blueshut
off: clkshut
off: imagshut

%dac: z1coil dmbz_center
%t += 15

%%%lattice SB cool

%daclinspace: latticepow lattice_pow -5 10 50
%t += 15

pulseon: resetdds .1
t += .2
repeat: 7
 pulseon: stepdds 0.007
 t += .1
end
t += .1

repeat: 30
 on: radial
 t += .2
 off: radial
 t += .2
 on: axial
 t += .4
 off: axial
 t += .2
 on: radial2
 t += .2
 off: radial2
 t += .2
 on: axial
 t += .4
 off: axial
 t += .2
end

%on: radial
%on: radial2
%on: axial
%t += 60
%off: radial
%off: radial2
%off: axial

%repeat: 10
% on: radial
% t += 1
% off: radial
% on: radial2
% t += 1
% off: radial2
% on: axial
% t += 2
% off: axial
%end
%%%Tunneling

%%daclinspace: latticepow lattice_pow -2 30 50
%%t += 30.1
%daclinspace: axialpow ax_lattice_pow tunnel_pow_ax 60 150
%%t += 30.1
%daclinspace: latticepow lattice_pow pre_tunnel_pow_2D 60 150
%t += 65
%%daclinspace: axialpow -.028 tunnel_pow_ax 3 5
%%t += 3

%dac: latticepow tunnel_pow_2D
%t += tunnel_time

%daclinspace: latticepow pre_tunnel_pow_2D lattice_pow 10 30
%%t += 30.1
%daclinspace: axialpow tunnel_pow_ax ax_lattice_pow 10 30
%t += 10
%%daclinspace: latticepow -2 lattice_pow 30 50
%%t += 30.1


%daclinspace: axialpow ax_lattice_pow tunnel_pow_ax 20 100
%t += 21
%daclinspace: latticepow lattice_pow pre_tunnel_pow_2D 20 100
%t += 25

%dac: latticepow -2
%t += 3
%dac: axialpow tunnel_pow_ax
%t += 3
%dac: latticepow pre_tunnel_pow_2D
%t += 8

%pulseon: trigger .1
%%%
%dac: latticepow tunnel_pow_2D
%t += tunnel_time
%%%

%daclinspace: latticepow -.2 tunnel_pow_2D t_ramptime 150
%daclinspace: tweezerpow813 tweezer813_pow -.225 t_ramptime 150
%t += t_ramptime+1
%t += 10

%repeat: 100
%  on: d15
%  t += scan
%  off: d15
%  t += 1
%end

%%%

%daclinspace: latticepow tunnel_pow_2D -.2 t_ramptime 150
%daclinspace: tweezerpow813 -.225 tweezer813_pow t_ramptime 150
%t += t_ramptime+1

%%%

%daclinspace: latticepow pre_tunnel_pow_2D lattice_pow 10 50
%%daclinspace: tweezerpow813 -.225 tweezer813_zero 10 50
%%daclinspace: tweezerpow813 tweezer813_pow tweezer813_zero 10 50
%t += 10
%daclinspace: axialpow tunnel_pow_ax ax_lattice_pow 10 50
%t += 10

%on: radial2
%on: axial
%t += 50
%off: radial2
%off: axial

%repeat: 50
% on: radial2
% t += .1
% off: radial2
% on: axial
% t += .1
% off: axial
%end

pulseon: resetdds .1
t += .2

on: radial
on: radial2
on: axial
t += 5
off: radial
off: radial2
off: axial

%daclinspace: latticepow -5 lattice_pow 10 50
%t += 15

%%% 3p1 Spectroscopy
repeat: 3
 pulseon: stepdds 0.007
 t += .1
end
t += .1

%daclinspace: latticepow lattice_pow -.6 15 30
%t += 20
%call spect3p1()
%daclinspace: latticepow -.6 lattice_pow 15 30
%t += 15

%dac: z1coil dmbz
%t += 15

%%%Image lattice
dac: imagingPow imagpowlat  % imagpowscan

pulseon: resetdds .1
t += .2
pulseon: stepdds 0.007
t += .1

call imagelat(300)

off: shut688
on: tweezershut
call magicfields515()
dac: bigzcoil 0


t += 15 %Remove stripe from 2nd image - unclear where this coming from

%%%END
% don't remove these!

%dac: tweezerpow tweezer_pow
%dac: axialpow ax_lattice_zero
