t = 1
%pulseon: trigger .1
pulseon: resetdds .1
%pulseon: mmload .007
pulseon: gmload .0001

t += .1
off: mirroractive 
dac: mirror_x mirrorscanx
dac: mirror_y mirrorscany

dac: uvpm_h 5.7  %3.75    %0-7.5 : 150-0 V
dac: uvpm_v 3 %3.75  %5          %0-10  : 0-150 V

%DDS state: MOT
repeat: 3
 pulseon: stepdds 0.007
 t += .1
end

dac: axial_piezo axial_phase_set
dac: axial_piezo2 10-axial_phase_set

off: shutuv
call ttlReset() 
t += 1

dac: bluetune bluetuneval
dac: intensity698 0
dac: imagtune tune461
dac: int633servo 1.4
dac: uvintservo .5

%dac: tweezerpow 0
%dac: axialpow ax_lattice_pow
dac: axialpow ax_lattice_zero
dac: tweezerpow tweezer_pow
dac: red3dpow 1.5 %about maximum
%dac: latticepow lattice_pow
dac: latticepow lattice_zero
dac: intensity698 0


t += 1

%dac: axialpow -2
%off: tweezerao
%off: tweezer813ao
%off: axlatTTL

%%REMOVE
t += 1

%on: imagshut

on: blueshut
on: shut707
on: shut679
on: rp707
on: rp679

%on: shut688
%on: rp688

%%%%
%on: imagshut %%Used for mako_image_singleBeam
%%%%
%on: blowawayttl
call blue_mot(30)
off: blowawayttl
off: rp707
off: rp679
off: rp688
off: shut707
off: shut679
off: shut688

off: metertrig
off: radial

off: slower

%call mako_image()

off: blueshut %comment out for mako imaging, uncomment to have andor imaging after redmot.

dac: bluetune 0.4 %0.1  %.6 for blue3d imaging.

%%%%%
%on: axial
%on: rp688
%on: shut688
call red_mot(swapmottime)
off: rp688
off: shut688

%off: axial
%%%%%

t += .01

%call mako_image()
on: metertrig


%on: andorshut
%on: imagshut
%t += 5
%call imageshort()

off: mirroractive

dac: bigzcoil 0

call magicfields515()
%call fieldzero()
%call fields532()

%dac: latticepow lattice_zero
on: imagshut
on: shut707
on: shut679

off: blueshut %Extra shutter for safety.

t += 12.5 %dropping red MOT
%call imageshort()
%%%Light assisted collisions%%%
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
%t += .1
%pulseon: mmload 0.007
%t += .1

dac: bluetune bluetune_imag
dac: imagingPow imagpow
%on: rp707

t += .1

on: rp707
on: rp679
on: imag461
%on: radial2
on: radial
on: axial
t += 25
off: radial2
off: axial
off: radial
off: imag461
off: shut707
off: shut679
off: rp707
off: rp679

%off: imagshut

pulseon: gmload .0001
t += .1

%%%REPEAT START%%%
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

dac: latticepow lattice_zero
t += 5

%%%1st image
%call imageshort()
%call imagec()

%%%SB COOL
%DDS state: SB cooling
pulseon: resetdds .1
t += .2

repeat: 50
 on: axial
 t += .1
 off: axial
% on: radial2
% t += .1
% off: radial2
 on: radial
 t += .1
 off: radial
end

on: lat813ao
t += 1

%call fieldzero()
%call magicfields515_axial()
%call magicfields813()
call magicfieldsDual813()

%dac: z1coil .0115
%daclinspace: y1coil .7 .0075 10 10
%daclinspace: y2coil .7 .0075 10 10
%dac: x1coil .0075
%t += 11

daclinspace: axialpow ax_lattice_zero ax_lattice_pow 10 15
t += 11
daclinspace: latticepow lattice_zero lattice_pow 10 15
t += 11
daclinspace: tweezerpow tweezer_pow tweezer_zero 10 15
%daclinspace: tweezerpow tweezer_pow filter_pow 10 15
t += 10
off: tweezershut
t += 10

dac: tweezerpow tweezer_pow
t += .01

%%%Fake image

dac: imagingPow imagpowscan

%on: imagshut
off: shut688
off: shut679
off: shut707
t += 4

%%%image lattice
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

t += 1
on: shut679
on: shut707
t += 4
on: rp679
on: rp707
call imagelat(200)
t += 15
off: rp679
off: rp707
off: shut679
off: shut707
t += 4

%%%SB COOL LATTICE
pulseon: resetdds .1
t += .2
repeat: 4
 pulseon: stepdds 0.007
 t += .1
end
t += .1

repeat: 50
 on: radial2
 t += .1
 off: radial2
 %on: radial
 %t += .1
 %off: radial
 on: axial
 t += .1
 off: axial
end

%pulseon: resetdds .1
%t += .2
%pulseon: stepdds 0.007
%t += .01
%call shelve3p0(1)

%daclinspace: axialpow ax_lattice_pow -0.1 10 15
%t += 11
%daclinspace: latticepow lattice_pow -0.5 10 15
%t += 11

%%% clock spectroscopy 
off: clockttl
%on: shut679
%call fieldzero()
call fieldbigz()
on: imagshut
off: shutuv
t += 70
off: clockttl
%DDS state: spectroscopy2
pulseon: stepdds 0.007
t += .1

%daclinspace: axialpow ax_lattice_pow -.2 10 15
%t += 11


%pulseon: trigger .0001
on: clockttl
%t += pihalvestime %0.466 %0.275
t += probetime %pitime
off: clockttl

%daclinspace: latticepow lattice_pow -1.25 2 .1
%t += 5

%off: lat813ao
%off: axlatTTL
t += 0.0008
pulseon: awgtrig 0.0001 %%%Needs to be shorter than duration of awg pulse
t += (uvtime+2*ramptime)/1000+.0002
%t += uvtime/1000+.0002
%t += 0.0003
on: axlatTTL
on: lat813ao
pulseon: trigger .0001
t += .0005

on: blowawayttl
t += 5
off: blowawayttl
off: imagshut
%on: imagshut
t += 4

%on: clockttl
t += pitime %pitime %.466 %0.275 %0.27 %probetime
off: clockttl

%daclinspace: latticepow lattice_pow -1 2 15
%t += 2.5

%pulseon: trigger .0001
%off: axlatTTL
%off: lat813ao
t += 0.0008
%pulseon: awgtrig 0.0001 %%%Needs to be shorter than duration of awg pulse
t += (uvtime+2*ramptime)/1000+.0002
%t += uvtime/1000+.0002
on: axlatTTL
on: lat813ao
t += .0005

%daclinspace: latticepow -.15 lattice_pow 2 15
%t += 2.5

%on: clockttl
t += pihalvestime %0.56 %0.275 
off: clockttl
t += 0.001

%daclinspace: latticepow lattice_pow -.75 5 15
%t += 5
%daclinspace: axialpow -1  -.5 5 15
%t += 5
%t += 20
%daclinspace: axialpow -.5 -1 5 15
%t += 5
%daclinspace: latticepow -.75 lattice_pow 5 15
%t += 5

%daclinspace: latticepow -1.25 lattice_pow 2 .1
%t += 1

%daclinspace: latticepow lattice_pow -.45 10 15
%daclinspace: axialpow ax_lattice_pow -.09 10 15
%t += 11

%t += 200

%t += ramseytime

%daclinspace: latticepow -.45 lattice_pow 10 15
%daclinspace: axialpow -.09 ax_lattice_pow 10 15
%t += 11

%pulseon: stepdds 0.007
t += .015
t += sigmaztime
%t += 7.5439*uvtime/1000
pulseon: stepdds .007
t += .015

%on: clockttl
t += pihalvestime %0.56 %0.275 
%t += pitime
off: clockttl
t += 0.01

off: shutuv
t += 4 

%daclinspace: axialpow -.2  ax_lattice_pow 10 15
%t += 11

call magicfieldsDual813()
dac: bigzcoil 0
t += 30
on: bigzantihelm
t += 5
dac: bigzcoil .15
t += 5
dac: bigzcoil 0
t += 5

%%%clock lifetime

%daclinspace: latticepow lattice_pow -.45 10 15
%daclinspace: axialpow ax_lattice_pow -.09 10 15
%t += 11
%t += scan
%daclinspace: latticepow -.45 lattice_pow 10 15
%daclinspace: axialpow -.09 ax_lattice_pow 10 15
%t += 11

%%% Blowaway gnd, 3P2, repump 3P0
off: imagshut 
on: shut707 
on: shut679 
t += 4
on: rp707
t += 1
on: blowawayttl
t += 1
off: blowawayttl
t += .1
on: rp679 
t += 4
off: rp707 
off: rp679 
off: shut707 
off: shut679 
off: imagshut 
t += 4
%%%

t += 60 % extra time for B fields to settle.

%%% 3p1 Spectroscopy
pulseon: resetdds .1
t += .2
pulseon: stepdds 0.007
t += .1

%%% VV NOTE: for 2D lattice ONLY probe with radial2.

%on: imagshut
t += 4

%on: axial
%on: radial
%on: radial2
t += .1
off: axial
off: radial
off: radial2

%on: blowawayttl
t += .002
%off: axlatTTL
%off: lat813ao
t += .001
on: axlatTTL
on: lat813ao
t += .001
off: blowawayttl
%off: pi407
off: imagshut
t += 4

%%% Image ground state
%pulseon: stepdds 0.007
%t += .1
%call imagelat(200) %can't have repumps for this image.
%t += 15
%pulseon: resetdds .1
%t += .2
%pulseon: stepdds 0.007
%t += .1

pulseon: stepdds 0.007
t += .1
call imagelat(200)
t += 15

dac: tweezerpow tweezer_zero
t += 5

off: shut688
on: tweezershut
call magicfields515()
dac: bigzcoil 0
t += 1
daclinspace: tweezerpow tweezer_zero tweezer_pow 10 15
%daclinspace: tweezerpow filter_pow tweezer_pow 10 15
t += 11
%daclinspace: latticepow lattice_pow lattice_zero 10 15
%t += 11
%daclinspace: axialpow ax_lattice_pow ax_lattice_zero 10 15
%t += 11
%on: bigzantihelm


t += 4
%%%
%on: imagshut 
%on: shut707 
%on: shut679 
%t += 4
%on: rp707
%t += 2
%on: blowawayttl
%t += 1
%off: blowawayttl
%t += 0.1 
%on: rp679 
%t += 4 
%off: rp707 
%off: rp679 
%off: shut707 
%off: shut679 
%off: imagshut 
%t += 4 
%%%

%%%2nd image, no repumps if doing clock spec
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

t += 1
%call imagec()
off: imagshut
on: lat813ao
t += 1
dac: latticepow lattice_pow

%t += 15 %Remove stripe from 2nd image - unclear where this coming from

%t += 2000

%end
%%%REPEAT END%%%

%pulseon: mmmove 0.01
%t += .1

%%%END
% don't remove these!

