%t += 5
%dac: tweezerpow -.025
%dac: tweezerpow -.0045
%dac: tweezerpow .0043
%t += tunnel_time
%t += 2.46
%%%
%daclinspace: latticepow tunnel_pow_2D -.2 t_ramptime 150
%daclinspace: tweezerpow813 -.225 tweezer813_pow t_ramptime 150
%t += t_ramptime+1

%%%

%daclinspace: latticepow -.2 lattice_pow 10 50
%daclinspace: tweezerpow813 -.225 tweezer813_zero 10 50
%%daclinspace: tweezerpow813 tweezer813_pow tweezer813_zero 10 50
%t += 11

%off: tweezershut
%daclinspace: axialpow tunnel_pow_ax ax_lattice_pow 10 50
%t += 11

%pulseon: gmload .0001 %%% WANT EVEN NUMBER OF LOAD TRIGGERS. 2 before tunneling
%t += .1
%pulseon: gmload .0001
%t += .1

dac: tweezerpow tweezer_pow

%%%

%%% 3p1 Spectroscopy
pulseon: resetdds .1
t += .2
pulseon: stepdds 0.007
t += .1

%%% VV NOTE: for 2D lattice ONLY probe with radial2.

%on: imagshut
%t += 4

%on: axial
%on: radial
%on: radial2
t += .1
off: axial
off: radial
off: radial2

