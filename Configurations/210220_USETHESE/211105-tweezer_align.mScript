t = 1
pulseon: resetdds .1
pulseon: gmload .0001 %%%1

t += .1
off: mirroractive 
dac: mirror_x mirrorscanx
dac: mirror_y mirrorscany

%DDS state: MOT
repeat: 3
 pulseon: stepdds 0.007
 t += .1
end

dac: axial_piezo axial_phase_set
dac: axial_piezo2 10-axial_phase_set

call ttlReset() 
t += 1

dac: bluetune bluetuneval
dac: imagtune tune461
dac: int633servo 1.

%dac: tweezerpow 0
%dac: axialpow ax_lattice_pow
dac: axialpow ax_lattice_zero
dac: tweezerpow tweezer_pow
dac: red3dpow 1.5 %about maximum
%dac: latticepow lattice_pow
dac: latticepow lattice_zero
dac: tweezerpow813 tweezer813_zero
%dac: tweezerpow813 tweezer813_pow

t += 1

%dac: axialpow -2
%off: tweezerao
%off: tweezer813ao
%off: axlatTTL

%%REMOVE
t += 1

%on: imagshut

on: blueshut
on: shut707
on: shut679
on: rp707
on: rp679

%on: shut688
%on: rp688

%%%%
%on: imagshut %%Used for mako_image_singleBeam
%%%%
%on: blowawayttl
call blue_mot(60)
off: blowawayttl
off: rp707
off: rp679
off: rp688
off: shut707
off: shut679
off: shut688

off: metertrig
off: radial

off: slower

%call mako_image()

off: blueshut %comment out for mako imaging, uncomment to have andor imaging after redmot.

dac: bluetune 0.4 %0.1  %.6 for blue3d imaging.

%%%%%
%on: axial
%on: rp688
%on: shut688
call red_mot(swapmottime)
off: rp688
off: shut688

%off: axial
%%%%%
%call mako_image()
on: metertrig


%on: andorshut
%on: imagshut
%t += 5
%call imageshort()

off: mirroractive

dac: bigzcoil 0

call magicfields515()
%call fieldzero()
%call fields532()

%dac: latticepow lattice_zero
on: imagshut
on: shut707
on: shut679

off: blueshut %Extra shutter for safety.

t += 12.5 %dropping red MOT
%call imageshort()
%%%Light assisted collisions%%%
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
%t += .1
%pulseon: mmload 0.007
%t += .1

dac: bluetune bluetune_imag
dac: imagingPow imagpow
%on: rp707

t += .1

on: rp707
on: rp679
on: imag461
%on: radial2
on: radial
on: axial
t += 25
off: radial2
off: axial
off: radial
off: imag461
off: shut707
off: shut679
off: rp707
off: rp679

%off: imagshut

pulseon: gmload .0001 %%%2
t += .1

%%%REPEAT START%%%
%DDS state: Image
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

%%%1st image
%call imageshort()
%call imagec()

%%%SB COOL
%DDS state: SB cooling
pulseon: resetdds .1
t += .2

repeat: 50
 on: axial
 t += .1
 off: axial
% on: radial2
% t += .1
% off: radial2
 on: radial
 t += .1
 off: radial
end

on: lat813ao
t += 1

%call fieldzero()
%call magicfields515_axial()
call magicfieldsdual813()

%%% handoff with moves
%pulseon: gmmove .0001 %%%important = remember to remove to search.
%t += .5

%daclinspace: axialpow ax_lattice_zero ax_lattice_pow 2 15
%t += 2
%daclinspace: latticepow lattice_zero lattice_pow 2 15
%t += 2
%daclinspace: tweezerpow tweezer_pow tweezer_zero 2 15
%t += 5

%off: tweezerao
%pulseon: gmload .1 %%%3
t += .1

%%% normal handoff
daclinspace: axialpow ax_lattice_zero ax_lattice_pow 10 15
t += 11
daclinspace: latticepow lattice_zero lattice_pow 10 15
t += 11
daclinspace: tweezerpow tweezer_pow tweezer_zero 10 15
%daclinspace: tweezerpow tweezer_pow filter_pow 10 15
t += 15

%%%
off: tweezershut
t += 10
on: tweezerao
dac: tweezerpow tweezer_pow
t += .01

%%%SB COOL LATTICE
pulseon: resetdds .1
t += .2
repeat: 4
 pulseon: stepdds 0.007
 t += .1
end
t += .1

repeat: 50
 on: radial2
 t += .1
 off: radial2
 on: axial
 t += .1
 off: axial
end

%%%Fake image

dac: imagingPow imagpowlat  % imagpowscan

%on: imagshut
%off: shut688
%t += 4

%%%image lattice
pulseon: resetdds .1
t += .2
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

call imagelat(200)
off: imagshut %%%IMPORTANT
t += 5

%%%lattice SB cool
repeat: 2
 pulseon: stepdds 0.007
 t += .1
end
t += .1

repeat: 50
 on: radial2
 t += .1
 off: radial2
 on: axial
 t += .1
 off: axial
end

%pulseon: trigger .1
%%%Tunneling
%daclinspace: axialpow ax_lattice_pow tunnel_pow_ax 10 50
%t += 11
%daclinspace: latticepow lattice_pow -.2 10 50
%daclinspace: tweezerpow813 tweezer813_zero tweezer813_pow 10 50
%t += 11
pulseon: trigger .1
%%%
%dac: latticepow tunnel_pow_2D
%t += tunnel_time
%%%

%daclinspace: latticepow -.2 tunnel_pow_2D t_ramptime 150
%daclinspace: tweezerpow813 tweezer813_pow -.225 t_ramptime 150
%t += t_ramptime+1
%t += 10

%repeat: 100
%  on: d15
%  t += scan
%  off: d15
%  t += 1
%end

%%%
