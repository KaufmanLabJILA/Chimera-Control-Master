% Master-Script See the "?" for info on commands.
def rerng_NNtest():

on: t515hold
pulseon: gmload .0001
t += .1
pulseon: gmmove .0001
t += .1
on: tweezershut
t += 5

%pulseon: trigger .1

on: radial
on: radial2
%on: axial

% change number of repeats according to right number
% 24 + 22 gets first column, 23 first two
repeat: 24+16  %+42
 pulseon: gmmove .00011
 t += 0.08
%t += 1000.1
 pulseon: gmmove .00011
 t += 1.11
%t += 300.1
 pulseon: gmmove .00011
 t += 0.08
%t += 300.1
end

repeat: 0 
 pulseon: gmmove .00011
 t += 0.08
%t += 1000.1
 pulseon: gmmove .00011
 t += 1.11
%t += 1000.1
 pulseon: gmmove .00011
 t += 0.08
%t += 300.1
end

off: radial
off: radial2
off: axial

off: tweezershut
t += 5

dac: tweezerpow tweezer_pow
pulseon: gmload .0001
t += 1
off: t515hold

