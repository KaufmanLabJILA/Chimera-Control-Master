% Master-Script See the "?" for info on commands.
def sbcool_pulsed(timeperpulse, pulses):
  % insert commands here...
  %off: coolSH
  repeat: pulses
   on: radial
   t += timeperpulse
   off: radial
   on: axial
   t += timeperpulse
   off: axial
   on: radial2
   t += timeperpulse
   off: radial2
  end
  on: coolSH
  t += .01
