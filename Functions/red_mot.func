def red_mot(loadTime):
  on: red3d

  %dac: bigzcoil 0.145
  daccosspace: bigzcoil bigz_bluemot*bigz_conv bigz_redmot*bigz_conv 30 40
  %dac: bigzcoil scanbigz
  %dac: bigzcoil 0.157/factor % changed 241114
  %dac: bigzcoil redmotbigz
  dac: red3dpow 0.65 %1.5 %.4 %.8 %.25 %.5
  
  %dac: x1coil .01  %.005
  %dac: y1coil .013  %.018
  %dac: y2coil .013  %.018
  %dac: z1coil .021  %.025 

  dac: x1coil rmbx
  daccosspace: y1coil bmby rmby 30 80
  daccosspace: y2coil bmby rmby 30 80
  dac: z1coil rmbz

  t += loadTime+30
 
  %daclinspace: red3dpow 1.5 0.5 10 20
  %t += 10

  %on: blueshut
  %t += 6

  off: red3d
  %dac: motcoils .5
  %dac: red3dpow .5

  % Additional cooling with narrow-line red MOT
  %dac: x1coil rmbx
  %dac: y1coil rmby
  %dac: y2coil rmby
  %dac: z1coil rmbz 
 
  on: red3dnarrow
  t += narrowmottime
  %%%%%%%%%%%%%%%%%%%%%%%
%  on: andorshut
%  on: imagshut
%  t += 4
  %%%%%%%%%%%%%%%%%%%%%%%

  off: red3dnarrow

 %dac: red3dpow .15
  %t += 30
  %t += 20

