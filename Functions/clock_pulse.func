% Master-Script See the "?" for info on commands.
def clock_pulse(time, a, b, c, sh):
  %% set rf to right wieserDDS snapshot
  off: clockttl
  t += .002 
  variableon: wiesera a
  variableon: wieserb b
  variableon: wieserc c
  t += .002

  %% perform pulse
  on: clockttl
  t += .01
  variableon: clockhold sh
  t += (time-.02)
  on: clockhold
  t += .01
  off: clockttl
  t += .005
  
  %% set to probe shift compensation snapshot
  off: wiesera
  on: wieserb
  on: wieserc
  t += .001
