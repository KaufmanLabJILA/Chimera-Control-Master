% Master-Script See the "?" for info on commands.
def image(imageTime, image_pow, andorState):
 
 %%% Set imaging and cooling freq/powers
 dac: imagpow1 (image_pow * imagpowratio12)
 dac: imagpow2 image_pow

 %%% Open shutters
 on: shut707
 on: shut679
 on: andorshut
 on: imagshut
 on: lampttl
 t += 4

 %%% Trigger camera
 variableon: andortrig andorState
 t += .2

 %%% Turn beams on
 on: rp707
 on: rp679
 on: axial
 on: radial2
 on: radial
 on: imag461
 t += 0.01

 %%% Sample image/cooling beams
 off: coolSH
 off: imageSH

 %%% image time
 t += imageTime

 %%% Hold image/cooling beams
 on: imageSH
 on: coolSH
 t += 0.01

 %%% Turn beams off and close shutters
 off: axial
 off: radial2
 off: radial
 off: imag461
 off: andortrig
 off: andorshut
 off: rp707
 off: rp679
 off: shut707
 off: shut679
 off: imagshut
 off: lampttl
 t += 4