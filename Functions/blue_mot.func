def blue_mot(loadTime):

  %% open shutters
  on: blueshut %reminder that this needed to be on earlier
  on: shut679
  on: shut707
  t += 4 

  %% turn on beams
  dac: blue3dpow 0.35
  on: blue3d
  on: red3d
  dac: red3dpow 0.55
  on: slower
  on: rp679
  on: rp707

  %% set fields
  dac: bigzcoil 1.8
  %dac: bigzcoil scanbigz
  %dac: bigzcoil 1.953/factor % changed 241114
  %dac: bigzcoil 1.94
  dac: x1coil -0.065
  dac: y1coil 0.065
  dac: y2coil 0.065
  dac: z1coil -0.11 % changed 240917
  %dac: z1coil scanz1

  t += loadTime

  %dacexpspace: blue3dpow .35 .001 12 9
  dacexpspace: blue3dpow .35 0.025 12 9
  %daclinspace: bigzcoil 1.8 0.15 12 15
  t += 8
%  dac: blue3dpow 0.02 %.06 %0.077
  t += 3

  %Try compressing the mot
  off: blue3d
%  off: rp707
%  off: rp679
  t += 0.01
  dac: blue3dpow 0.001
  t += .001
  on: blue3d
  t += 0.001

  %% shutter/turn off blue and repumps
  off: blueshut
  off: shut679
  off: shut707
  off: blue3d
  off: slower
  off: rp679
  off: rp707
  t += 4

